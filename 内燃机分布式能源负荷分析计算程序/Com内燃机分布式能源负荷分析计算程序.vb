    Public Sub 内燃机可以向外供电且内燃机余热可以浪费时供冷和蓄冷计算()
        On Error Resume Next
        '定义Excel对象
        Dim ExcelApp As Excel.Application '定义Excel对象
        ExcelApp = GetObject(, "Excel.Application")    '当前EXCEL对象赋值给ExcelApp
        '定义局部变量
        Dim XHLZLLFL
        '余热可以浪费
        '制冷和蓄冷，制冷和蓄冷，制冷和蓄冷，制冷和蓄冷，制冷和蓄冷，制冷和蓄冷
        '判断本工况冷负荷需求量是否为0，不为0 则进行下列计算
        If LFHZXQL(b) >= 0 Then
            '蓄能装置供冷量和蓄能时间，带入计算
            ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 13).Value = ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 13).Value '蓄能装置供冷
            ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 26).Value = ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 26).Value '蓄冷时间
            '将本工况蓄能量和蓄能时间带入计算一次
            ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 14).Value = ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 14).Value
            ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 25).Value = ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 25).Value
            '用户输入的制冷时内燃机负荷率代入计算
            ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 2), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 3)).Value = ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 2), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 3)).Value
            '记录下溴化锂制冷量
            XHLZL1 = ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(5, 4).Value * ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(6, 4).Value
            XHLZL2 = ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(24, 4).Value * ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(25, 4).Value
            XHLZL = XHLZL1 + XHLZL2
            '如果此时溴化锂制冷量与蓄能装置供冷功率之和小于冷负荷总需求量和蓄能装置蓄冷量之和，则内燃机余热不会被浪费，全部用于供冷和蓄冷
            If (XHLZL + XNGLGL(b)) <= (LFHZXQL(b) + XNXLGL(b)) Then
                '如果蓄冷量为0，冷负荷需求量大于0，则溴化锂的制冷量只用于供冷
                If (XNXLGL(b) = 0 And LFHZXQL(b) > 0) Then
                    '进行制冷设备计算，代码在模块1
                    Call 内燃机可以向外供电时制冷设备运行计算()
                    '进行蓄冷设备计算，代码在模块3
                    Call 蓄能装置蓄冷工况计算()
                End If
                '如果蓄冷量大于0，冷负荷需求量大于等于0，则溴化锂制冷量不仅用于供冷，也可以用于蓄冷
                If (XNXLGL(b) > 0 And LFHZXQL(b) >= 0) Then
                    '进行计算，代码在模块10
                    Call 内燃机可以向外供电时制冷和蓄冷设备运行计算()
                End If
            Else '如果此时溴化锂制冷量与蓄能装置供冷功率之和大于冷负荷总需求量和蓄能装置蓄冷量之和，则内燃机余热会被浪费
                '此时所有的供冷负荷和蓄冷负荷均有溴化锂提供，溴化锂多余的能量浪费掉
                '溴化锂制冷量分成三部分，一部分浪费掉，一部分用于供冷，一部分用于蓄冷
                '溴化锂制冷量被浪费的量等于溴化锂总制冷量减去冷负荷需求量减去蓄能蓄冷量
                XHLZLLFL = XHLZL - (LFHZXQL(b) - XNGLGL(b)) - 1.03 * XNXLGL(b) '溴化锂制冷浪费量，蓄能装置蓄能量放大百分之3，因为考虑到百分之2.5的蓄能散热损失修正
                ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 75).Value = XHLZLLFL
                ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 75).Value = XHLZLLFL
                '溴化锂供冷量等于本工况冷负荷总需求量减去蓄冷装置供冷量
                ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 71).Value = LFHZXQL(b) - XNGLGL(b)
                ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 71).Value = LFHZXQL(b) - XNGLGL(b)
                '溴化锂蓄冷量等于溴化锂总制冷量减去本工况冷负荷需求量
                If XNXLGL(b) > 0 Then
                    XHLXL = XHLZL - (LFHZXQL(b) - XNGLGL(b)) - XHLZLLFL
                    ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 73).Value = XHLXL
                    ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 73).Value = XHLXL
                End If
                '因为所有的供冷负荷均有溴化锂提供，则将所有的制冷空调负荷率设置为0
                ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 28), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 39)).Value = 0
                '因为此时所有的蓄冷量也由溴化锂提供，则将所有蓄冷空调数量设置为0
                ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 40), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 51)).Value = 0
            End If
