        '如果有内燃机装机量，采用以下计算
        If ExcelApp.ThisWorkbook.Worksheets("说明&常量设置&数据汇总").Cells(47, 7).Value > 0 Then
            '读取各种修正系数
            Dim ans_XZXS_R = 读取采暖季输入的计算系数(ExcelApp)
            '溴化锂制热COP
            Dim XHL_COP_R As Double = ans_XZXS_R(9)
