    Function 制冷季内燃机及其余热利用系统计算(ExcelApp As Object, b As Integer, ZLNRJFHL1 As Double, ZLNRJFHL2 As Double, calculation_mode As Integer)
        On Error Resume Next
        '————————————————————————————————————————————————————————————————————————————————————————  
        Dim XHLZL1 As Double '溴化锂制冷量1
