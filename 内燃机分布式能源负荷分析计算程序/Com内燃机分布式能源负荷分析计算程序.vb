                Dim ans_temp = 直燃型溴化锂供冷计算_方法二(ExcelApp, FHTJJD, LFH_max, NUM1, NUM2, ZJLGL1, ZJLGL2, BTHQ1_ED, BTHQ2_ED, FJHD1_ED, FJHD2_ED, ZLHQXZ, TRQHLXZXS_QT, FJHDXS)
                '计算结果加入列表
                HD_ALL.Add(ans_temp(1))
