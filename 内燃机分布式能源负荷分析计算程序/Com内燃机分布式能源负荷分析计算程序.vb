                ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 73).Value = 0
            End If
        End If
        '返回负荷率计算结果
        Dim ans(4)
        ans(0) = FHL1_result
        ans(1) = FHL2_result
        ans(2) = NUM1_result
        ans(3) = NUM2_result
        Return ans
    End Function

