    Public Sub 判断冷热负荷需求量是否大于冷热负荷装机量()
        On Error Resume Next
        '定义Excel对象
        Dim ExcelApp As Excel.Application '定义Excel对象
        ExcelApp = GetObject(, "Excel.Application")    '当前EXCEL对象赋值给ExcelApp
        '定义局部变量
        Dim XHLZLPD， ZZLGL
        Dim XHLZRPD, ZZRGL
        '将内燃机余热利用方式带入
        ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 77).Value = ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + a, 77).Value
        '计算制冷装机是否能够满足冷负荷需求量和蓄冷需求量
        '将制冷时内燃机负荷率全部设置为1
        ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 2), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 3)).Value = 1
        ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 4), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 5)).Value = 0
        '读取溴化锂制冷功率
        If ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + a, 77).Value = "溴化锂" Then
            XHLZLPD = ExcelApp.ThisWorkbook.Worksheets("说明&常量设置&数据汇总").Cells(47, 9).Value
        Else
            XHLZLPD = 0
        End If
        '计算所有设备总制冷功率
        ZZLGL = ExcelApp.ThisWorkbook.Worksheets("说明&常量设置&数据汇总").Cells(58, 7).Value + XHLZLPD + XNGLGL(a)
        If LFHZXQL(a) + XNXLGL(a) > ZZLGL Then
            MsgBox("出现了冷负荷总需求量+蓄冷负荷需求量之和大于所有设备总制冷量的情况！" & Chr(10) & "工况序号为：" & a)
            ZTJC = 1
            Call 锁定工作表()
            Exit Sub
        End If
        '计算制热装机是否能够满足热负荷需求量和蓄热需求量
        '将制热时内燃机负荷率全部设置为1
        ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 2), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 3)).Value = 0
        ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 4), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 5)).Value = 1
        '读取溴化锂制热功率
        If ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + a, 77).Value = "溴化锂" Then
            XHLZRPD = ExcelApp.ThisWorkbook.Worksheets("说明&常量设置&数据汇总").Cells(47, 9).Value
        Else
            XHLZRPD = 0
        End If
        '计算所有设备总制热功率
        ZZRGL = ExcelApp.ThisWorkbook.Worksheets("说明&常量设置&数据汇总").Cells(69, 7).Value + XHLZRPD + XNGRGL(a)
        If RFHZXQL(a) + XNXRGL(a) > ZZRGL Then
            MsgBox("出现了热负荷总需求量+蓄热负荷需求量之和大于所有设备总制热量的情况！" & Chr(10) & "工况序号为：" & a)
            ZTJC = 1
            Call 锁定工作表()
            Exit Sub
        End If
        '清空数据
        ExcelApp.ThisWorkbook.Worksheets("计算输入").Range("B3:CO3").ClearContents
    End Sub
    Public Sub 内燃机不可以向外供电时制冷设备运行计算()
        On Error Resume Next
        '定义Excel对象
        Dim ExcelApp As Excel.Application '定义Excel对象
        ExcelApp = GetObject(, "Excel.Application")    '当前EXCEL对象赋值给ExcelApp
        '定义局部变量
        Dim ZLNRJFHL, ZLNRJFHL1, ZLNRJFHL2
        '供冷，供冷 ，供冷 ，供冷 ，供冷
        '判断本工况冷负荷需求量是否为0，不为0 则进行下列计算
        If LFHZXQL(b) > 0 Then
            '蓄能装置供冷量和蓄能时间，带入计算
            ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 13).Value = ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 13).Value '蓄能装置供冷
            ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 25).Value = ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 25).Value '蓄冷时间
            '判断本工况总冷负荷需求量（kW）是否小于等于蓄冷装置总供冷量（kW）
            '如果本工况总冷负荷需求量（kW）是否大于蓄冷装置总供冷量（kW），则进行下列计算
            If LFHZXQL(b) > XNGLGL(b) Then
                '内燃机负荷率，从1递减
                '判断内燃机(1)和(2)是否都启用，如果两种都启用，则优先降低内燃机(2)的负荷率，当内燃机(2)的负荷率降至0时，再降低内燃机(1)的负荷率
                '如果只启用了一种内燃机，则可以使用下列代码进行计算
                If (ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(3, 2).Value = "J000GS" Or ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(22, 2).Value = "J000GS") Then
                    '使用二分法提高计算速度,代码在模块14
                    Call 内燃机不可以向外供电时制冷设备运行计算仅启动一种内燃机二分法提高计算速度()
                    '精细调整内燃机负荷率进行计算
                    For d = 0 To JSBC
                        '两种内燃机的负荷率同时降低，因为有一种内燃机没有开启，所以修改这种内燃机的负荷率对计算并不产生影响，在计算结束后将没有启动的那个内燃机负荷率设置为0即可，从而简化代码
                        ZLNRJFHL = NRJZLFHLSX - (FHTJJD / 100) * d '制冷内燃机负荷率
                        '将内燃机负荷率带入计算，并记录此时的溴化锂总制冷量
                        ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 2), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 3)).Value = ZLNRJFHL
                        '记录下溴化锂制冷量
                        XHLZL1 = ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(5, 4).Value * ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(6, 4).Value
                        XHLZL2 = ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(24, 4).Value * ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(25, 4).Value
                        XHLZL = XHLZL1 + XHLZL2
                        '将已有的制冷设备运行负荷率重置为0，每一次重新计算必需重置一次0
                        ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 28), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(3, 39)).Value = 0
                        '设备制冷计算
                        Call 设备六种顺序制冷计算1() '代码在模块1
                        Call 设备六种顺序制冷计算2() '代码在模块12
                        '设置跳出循环的条件，当向外供电量小于等于0，同时满足制冷负荷需求时，跳出循环
                        If (ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(40, 8).Value <= ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(42, 8).Value And ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(39, 4).Value >= LFHZXQL(b)) Then
                            '将此时的内燃机负荷率记录下来
                            ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 2), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 3)).Value = ZLNRJFHL
                            Exit For
                            '当向外供电量满足条件，但是制冷负荷需求不满足条件时
                        ElseIf (ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(40, 8).Value <= ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(42, 8).Value And ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(39, 4).Value < LFHZXQL(b)) Then
                            '将此时的内燃机负荷率记录下来
                            ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 2), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 3)).Value = ZLNRJFHL
                            '修正计算,代码在模块6
                            Call 内燃机不可以向外供电时制冷计算修正()
                            '当向外供电量不满足条件，同时不满足制冷负荷需求时
                        ElseIf (ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(40, 8).Value > ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(42, 8).Value And ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(39, 4).Value < LFHZXQL(b)) Then
                            '将此时的内燃机负荷率记录下来
                            ExcelApp.ThisWorkbook.Worksheets("计算输入").Range(ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 2), ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 3)).Value = ZLNRJFHL
                            '修正计算,代码在模块6
                            Call 内燃机不可以向外供电时制冷计算修正()
                        End If
                    Next
                End If
