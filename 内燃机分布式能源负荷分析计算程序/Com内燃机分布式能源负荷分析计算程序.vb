            XHLZL1 = ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(5, 4).Value * ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(6, 4).Value
