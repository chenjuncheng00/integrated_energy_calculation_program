        Else
            MsgBox("已超过最大尝试次数，不可以再尝试输入密码！")
            Call 工作表设置为彻底隐藏()
            Call 锁定工作表()
        End If
        '重新打开屏幕更新
        ExcelApp.Application.ScreenUpdating = True
