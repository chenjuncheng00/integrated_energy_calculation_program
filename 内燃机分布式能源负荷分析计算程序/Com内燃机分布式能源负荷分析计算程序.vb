        ExcelApp.Application.EnableCancelKey = XlEnableCancelKey.xlDisabled
        '程序开始
        Try '异常处理，防止无文件
            Dim fs As New FileStream("\\192.168.9.201\user1\CJC-陈俊丞\综合能源多联供项目计算工具\内燃机版计算程序\Version.txt", FileMode.Open)
