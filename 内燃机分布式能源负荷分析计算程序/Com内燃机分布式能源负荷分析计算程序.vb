                    Exit For '跳出循环
                End If
            Next
        End If
        If ((ZLZJSL2 - ZLQDSL2 > 0) And (ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(39, 24).Value > 1 Or ExcelApp.ThisWorkbook.Worksheets("设备选型&负荷分析计算").Cells(39, 24).Value = 0)) Then
