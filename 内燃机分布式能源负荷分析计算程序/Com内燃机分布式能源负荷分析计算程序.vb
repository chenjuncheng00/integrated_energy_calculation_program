        On Error Resume Next
        '定义Excel对象
        Dim ExcelApp As Excel.Application '定义Excel对象
        ExcelApp = GetObject(, "Excel.Application")    '当前EXCEL对象赋值给ExcelApp
        Dim 指定工况 As New 指定工况计算
        '————————————————————————————————————————————————————————————————————————————————————————
        '————————————————————————————————————————————————————————————————————————————————————————  
        Call Excel版本号验证()
        If ZTJC = 1 Then
            Call 锁定工作表()
            ZTJC = 0
