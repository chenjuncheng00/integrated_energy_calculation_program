                                End If
                            Else '如果没有蓄冷
                                If (XNGLGL(b) + XHLZL >= LFHZXQL(b) + XNXLGL(b)) Then
                                    '记录下此时内燃机(2)负荷率
                                    ExcelApp.ThisWorkbook.Worksheets("计算输入").Cells(7 + b, 3).Value = ZLNRJFHL2
                                    Exit For
                                End If
                            End If
                        Next
                    End If
                ElseIf calculation_mode = 2 Then
                    '本模块，当存在两种内燃机，且计算模式=2时，采用全局寻优计算内燃机的负荷率
